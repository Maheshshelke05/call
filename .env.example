# ==============================================================================
# Environment Configuration Template
# Copy this file to .env (for local dev) or .env.production (for AWS deployment)
# DO NOT COMMIT SECRETS OR PRODUCTION KEYS TO GIT REPOSITORIES
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local
APP_NAME="Employee Calling & CRM Platform"
DEBUG=true

# Database Connection (MySQL / MariaDB or SQLite for standalone unit testing)
# Local Docker: mysql+pymysql://crm_user:crm_dev_password@localhost:3306/calling_crm
# SQLite: sqlite:///./telephony_crm_dev.db
DATABASE_URL=mysql+pymysql://crm_user:crm_dev_password@localhost:3306/calling_crm

# Redis Queue & Rate Limiting URL
REDIS_URL=redis://localhost:6379/0

# JWT Authentication & Cryptography
# Generate secure 256-bit key: openssl rand -hex 32
JWT_SECRET=change_this_to_a_cryptographically_secure_random_hex_string_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3 Private Storage Configuration (or MinIO local)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=employee-telephony-recordings-prod
# Optional endpoint URL for MinIO (e.g., http://localhost:9000). Leave empty for true AWS S3.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Audio Recording Retention & Presigned URL Lifetime
RECORDING_PRESIGNED_URL_EXPIRE_SECONDS=300
RECORDING_RETENTION_DAYS=90

# Admin Web Origin (for CORS headers)
ADMIN_WEB_ORIGIN=http://localhost:3000

# Mobile API Base URL (Point to your computer's LAN IP when testing on physical Android devices)
# Example: http://192.168.1.100:8000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
